.screen { min-height: 100vh; padding-bottom: 140rpx; background: #f5f6f5; color: #1d2939; }
.hero { position: relative; margin: 24rpx 32rpx 0; padding: 34rpx 30rpx 28rpx; border-radius: 34rpx; background: linear-gradient(135deg, #fff1ef, #fff); box-shadow: 0 14rpx 40rpx rgba(16,24,40,.06); }
.hero text { display: block; }
.hero > text:first-child { color: #98a2b3; font-size: 22rpx; }
.digits { margin-top: 10rpx; color: #172334; font-size: 54rpx; font-weight: 800; letter-spacing: 2rpx; }
.hint { margin-top: 16rpx; color: #667085; font-size: 22rpx; }
.badge { position: absolute; top: 28rpx; right: 26rpx; padding: 6rpx 14rpx; border-radius: 16rpx; background: #fff6e8; color: #b76e00; font-size: 20rpx; font-weight: 700; }
.badge.green { background: #e8f8ef; color: #087443; }
.card { margin: 24rpx 32rpx 0; padding: 28rpx 24rpx 16rpx; border-radius: 32rpx; background: #fff; box-shadow: 0 14rpx 40rpx rgba(16,24,40,.06); }
.title, .line, .goods { display: flex; align-items: center; justify-content: space-between; }
.title { padding: 0 4rpx 14rpx; }
.title .b { font-size: 30rpx; font-weight: 700; }
.title text:last-child { color: #98a2b3; font-size: 22rpx; }
.goods { gap: 20rpx; padding: 16rpx 0; border-top: 1px solid #edf0f2; }
.meta { min-width: 0; flex: 1; }
.meta .b, .meta text { display: block; }
.meta .b { overflow: hidden; font-size: 26rpx; white-space: nowrap; text-overflow: ellipsis; }
.meta text { margin-top: 8rpx; color: #98a2b3; font-size: 22rpx; }
.qty { color: #667085; font-size: 26rpx; }
.line { gap: 28rpx; padding: 16rpx 4rpx; border-top: 1px solid #edf0f2; }
.line:first-child { border-top: 0; }
.line text { color: #98a2b3; font-size: 24rpx; }
.line .b { flex: 1; color: #344054; font-weight: 500; text-align: right; }
.bar { position: fixed; left: 0; right: 0; bottom: 0; padding: 20rpx 32rpx 24rpx; background: #fff; border-top: 1px solid #edf0f2; }
.btn, .primary { height: 84rpx; border-radius: 24rpx; background: #f3332b; color: #fff; text-align: center; line-height: 84rpx; font-size: 28rpx; font-weight: 700; }
.mask { position: fixed; inset: 0; z-index: 5; display: flex; align-items: center; justify-content: center; padding: 48rpx; background: rgba(16,24,40,.46); }
.dialog { width: 100%; padding: 44rpx 36rpx 28rpx; border-radius: 40rpx; background: #fff; text-align: center; }
.ok { width: 76rpx; height: 76rpx; margin: 0 auto 22rpx; border-radius: 28rpx; background: #e8f8ef; color: #087443; font-size: 40rpx; font-weight: 800; line-height: 76rpx; }
.ask { display: block; font-size: 32rpx; font-weight: 700; }
.desc { display: block; margin: 20rpx 0 36rpx; color: #667085; font-size: 24rpx; line-height: 1.6; }
.strong { color: #d92a24; font-weight: 700; }
.actions { display: flex; gap: 20rpx; }
.actions view { flex: 1; height: 78rpx; border-radius: 24rpx; background: #f2f4f7; color: #475467; line-height: 78rpx; font-size: 26rpx; font-weight: 650; }
.actions .primary { background: #f3332b; color: #fff; }
