.screen { height: 100vh; display: flex; flex-direction: column; background: #f5f6f5; color: #1d2939; }
.hero { padding: 24rpx 32rpx 84rpx; color: #fff; background: radial-gradient(circle at 88% 12%, rgba(255,255,255,.22), transparent 24%), linear-gradient(145deg, #c92320, #f6534b 62%, #fa7c73); }
.point { display: flex; align-items: center; gap: 18rpx; }
.mark { width: 68rpx; height: 68rpx; flex: none; border: 1px solid rgba(255,255,255,.5); border-radius: 24rpx; background: rgba(255,255,255,.14); text-align: center; line-height: 68rpx; font-size: 28rpx; font-weight: 750; }
.copy { min-width: 0; flex: 1; }
.name, .addr, .hero-copy text { display: block; }
.name { overflow: hidden; font-size: 30rpx; font-weight: 700; white-space: nowrap; text-overflow: ellipsis; }
.addr { margin-top: 6rpx; color: rgba(255,255,255,.76); font-size: 20rpx; }
.open { flex: none; padding: 6rpx 14rpx; border-radius: 18rpx; background: rgba(255,255,255,.16); font-size: 20rpx; }
.hero-copy { margin-top: 46rpx; }
.hero-copy text { color: rgba(255,255,255,.72); font-size: 22rpx; }
.count { display: inline; margin-top: 8rpx; font-size: 64rpx; font-weight: 750; line-height: 1; color: #fff; }
.unit { display: inline; margin-left: 14rpx; color: rgba(255,255,255,.8); font-size: 22rpx; }
.nav { height: 88rpx; display: flex; align-items: center; justify-content: center; background: #fff; font-size: 34rpx; font-weight: 700; box-sizing: content-box; }
.body { flex: 1; height: 0; }
.body.plain { background: #f5f6f5; }
.search { margin: -50rpx 32rpx 0; padding: 28rpx 26rpx 24rpx; border-radius: 34rpx; background: #fff; box-shadow: 0 20rpx 48rpx rgba(16,24,40,.11); }
.search .label { display: block; font-size: 28rpx; font-weight: 700; }
.row { height: 84rpx; display: flex; align-items: center; gap: 16rpx; margin-top: 20rpx; padding-left: 24rpx; border: 1px solid #e4e7ec; border-radius: 24rpx; background: #fafbfc; }
.row input { min-width: 0; flex: 1; font-size: 30rpx; letter-spacing: 2rpx; }
.go { height: 68rpx; margin-right: 8rpx; padding: 0 26rpx; border-radius: 20rpx; background: #f3332b; color: #fff; font-size: 24rpx; font-weight: 700; line-height: 68rpx; }
.tip, .hint { display: block; margin-top: 16rpx; color: #98a2b3; font-size: 20rpx; }
.summary { display: flex; margin: 26rpx 32rpx 0; overflow: hidden; border-radius: 32rpx; background: #fff; box-shadow: 0 14rpx 40rpx rgba(16,24,40,.06); }
.summary view { flex: 1; min-height: 132rpx; padding: 20rpx 10rpx; text-align: center; }
.summary view + view { border-left: 1px solid #edf0f2; }
.summary text { display: block; color: #98a2b3; font-size: 22rpx; }
.num { margin-top: 8rpx; color: #1d2939; font-size: 38rpx; font-weight: 750; }
.section { display: flex; align-items: center; margin: 42rpx 36rpx 16rpx; }
.section .b { font-size: 32rpx; font-weight: 700; }
.card { margin: 0 32rpx 20rpx; padding: 26rpx; border-radius: 32rpx; background: #fff; box-shadow: 0 14rpx 40rpx rgba(16,24,40,.06); }
.top, .mid, .foot { display: flex; align-items: center; justify-content: space-between; }
.top text { color: #98a2b3; font-size: 20rpx; }
.badge { padding: 6rpx 14rpx; border-radius: 16rpx; background: #fff6e8; color: #b76e00; font-size: 20rpx; font-weight: 700; }
.badge.green { background: #e8f8ef; color: #087443; }
.mid { align-items: flex-end; margin: 20rpx 0; }
.tiny, .digits, .wait { display: block; }
.tiny { color: #98a2b3; font-size: 20rpx; }
.digits { margin-top: 6rpx; color: #172334; font-size: 44rpx; font-weight: 800; letter-spacing: 2rpx; }
.wait { padding-bottom: 6rpx; color: #b76e00; font-size: 22rpx; }
.foot { padding-top: 18rpx; border-top: 1px solid #edf0f2; }
.foot text { color: #667085; font-size: 22rpx; }
.link { color: #d92a24; }
.hint { margin: 28rpx 48rpx 48rpx; text-align: center; line-height: 1.6; }
.empty { margin-top: 80rpx; color: #98a2b3; font-size: 26rpx; text-align: center; }
.filters { display: flex; gap: 16rpx; padding: 24rpx 32rpx 8rpx; }
.filters view { height: 60rpx; padding: 0 24rpx; border-radius: 30rpx; background: #fff; color: #667085; font-size: 24rpx; line-height: 60rpx; box-shadow: 0 14rpx 40rpx rgba(16,24,40,.06); }
.filters .on { background: #fff0ef; color: #d92a24; font-weight: 700; }
.mine { margin: 32rpx; padding: 36rpx; border-radius: 32rpx; background: #fff; }
.mine-name, .mine-addr { display: block; }
.mine-name { font-size: 34rpx; font-weight: 700; }
.mine-addr { margin-top: 10rpx; color: #98a2b3; font-size: 24rpx; }
.out { margin-top: 36rpx; height: 80rpx; border-radius: 20rpx; background: #fff0ef; color: #d92a24; text-align: center; line-height: 80rpx; font-weight: 700; }
.tabbar { height: 116rpx; display: flex; flex: none; padding: 8rpx 12rpx 12rpx; border-top: 1px solid #edf0f2; background: #fff; }
.tabbar view { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; color: #98a2b3; }
.tabbar .on { color: #d92a24; }
.ico { width: 44rpx; height: 44rpx; border-radius: 16rpx; background: #f2f4f7; text-align: center; line-height: 44rpx; font-size: 22rpx; font-weight: 750; }
.tabbar .on .ico { background: #fff0ef; }
.tabbar text:last-child { font-size: 20rpx; font-weight: 650; }
